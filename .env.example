# No API keys are required for MealMate's two data sources.
# Copy this file to .env if you want to customise these values. (.env is gitignored.)

# Contact used in the User-Agent sent to Open Food Facts.
MEALMATE_CONTACT_EMAIL=you@example.com

# Bind address / port for local development.
MEALMATE_HOST=127.0.0.1
MEALMATE_PORT=5000

# Comma-separated list of allowed origins (leave blank to allow same-origin only).
MEALMATE_CORS_ORIGINS=

# In-process API cache duration in seconds (0 disables caching).
MEALMATE_CACHE_TTL=600

# Shown by /api/health so load-balanced deployments can identify the serving node.
MEALMATE_SERVER_NAME=local

# Upstream request tuning (milliseconds).
MEALMATE_REQUEST_TIMEOUT_MS=8000
MEALMATE_MAX_RETRIES=2
MEALMATE_RETRY_BASE_MS=250
